# Copy to .env.local (gitignored). Only the token is required.
METAPILOT_TOKEN=            # Edits → Settings → Automation → Access token

# Optional overrides (defaults live in server/config.mjs)
# METAPILOT_URL=http://127.0.0.1:19501/mcp
# PORT=4399
# CLAUDE_BIN=claude
# INSTAEDITS_JOBS_DIR=./jobs
# INSTAEDITS_STAGING_DIR=~/Movies/Instaedits   # the sandboxed Edits app can only read/write folders like ~/Movies
# INSTAEDITS_CACHE_DIR=./cache                  # reused across runs: transcripts, LLM answers, renders, audio
# INSTAEDITS_CACHE=off                          # force every step to recompute (debugging)
# INSTAEDITS_CACHE_MAX_GB=8                      # renders beyond this are pruned (least recently used)
# INSTAEDITS_EFFECTS_DIR=./vendor/claude-video-effects  # optional effects pack (npm run effects:install)
# INSTAEDITS_SCREENS_DIR=./screens              # token-redacted Edits screenshots (reused for 7 days)
# INSTAEDITS_TERMS=Remotion, Claude Code, Kafka  # names to spell right in captions/graphics (default list in config.mjs)
# INSTAEDITS_MODEL_DIRECTOR=claude-opus-5-5
# INSTAEDITS_MODEL_TRANSLATOR=claude-sonnet-5-5
# INSTAEDITS_MODEL_CAPTIONS=claude-sonnet-5-5
# INSTAEDITS_MODEL_REVIEWER=claude-sonnet-5-5

# Optional: raises the GitHub API limit (repo cards) from 60 to 5000 requests/hour. A token with NO scopes is enough.
# GITHUB_TOKEN=
# INSTAEDITS_GITHUB_API=https://api.github.com
